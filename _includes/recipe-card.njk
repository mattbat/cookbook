{%- set minutes = recipe.data | totalMinutes %}
<a class="card" href="{{ recipe.url | url }}" data-url="{{ recipe.url | url }}" data-tags="{% for tag in recipe.data.tags %}{{ tag | tagId }} {% endfor %}">
  <span class="card-photo">
    {%- if recipe.data.photo %}<img src="{{ recipe.data.photo.src | url }}" alt="">{% endif -%}
  </span>
  <span class="card-title">{{ recipe.data.title }}</span>
  <span class="card-meta">
    {%- if minutes %}{% icon "clock" %}{{ minutes | duration }}{% endif -%}
    {%- if minutes and recipe.data.author %} &middot; {% endif -%}
    {%- if recipe.data.author %}{{ recipe.data.author | replace(r/\s*\(.*\)$/, "") }}{% endif -%}
  </span>
</a>
