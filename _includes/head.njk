{%- if useSiteTitle -%}
  {%- set pageTitle = site.title + " - " + site.description -%}
{%- else -%}
  {%- set pageTitle = title or site.title -%}
{%- endif -%}
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

  <title>{{ pageTitle }}</title>
  {#- Recipes get a summary (their subtitle, or author, servings and ingredients) from _recipes.11tydata.js. #}
  {%- set metaDescription = summary or subtitle or site.description %}
  {%- set shareTitle = title or site.title %}

  <meta name="author" content="{{ site.author }}">
  <link rel="icon" type="image/x-icon" href="{{ '/favicon.ico' | url }}">
  <meta name="description" content="{{ metaDescription }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }} - {{ site.description }}" href="{{ '/feed.xml' | fullUrl }}">

  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.6.0/css/font-awesome.min.css">
  <link rel="stylesheet" href="{{ '/css/bootstrap.min.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/main.css' | url }}">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Lora:400,700,400italic,700italic">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Open+Sans:300italic,400italic,600italic,700italic,800italic,400,300,600,700,800">

  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ shareTitle }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="{{ page.url | fullUrl }}">
  <link rel="canonical" href="{{ page.url | fullUrl }}">
  {%- if photo %}
  <meta property="og:image" content="{{ photo.src | fullUrl }}">
  <meta property="og:image:alt" content="{{ photo.alt or shareTitle }}">
  {%- endif %}

  <meta name="twitter:card" content="{{ 'summary_large_image' if photo else 'summary' }}">
  <meta name="twitter:title" content="{{ shareTitle }}">
  <meta name="twitter:description" content="{{ metaDescription }}">
  {%- if photo %}
  <meta name="twitter:image" content="{{ photo.src | fullUrl }}">
  <meta name="twitter:image:alt" content="{{ photo.alt or shareTitle }}">
  {%- endif %}
</head>
