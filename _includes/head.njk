{%- if useSiteTitle -%}
  {%- set pageTitle = site.title + " - " + site.description -%}
{%- else -%}
  {%- set pageTitle = title or site.title -%}
{%- endif -%}
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

  <title>{{ pageTitle }}</title>
  {#- Recipes get a summary (their subtitle, or author, servings and ingredients) from _recipes.11tydata.js. #}
  {%- set metaDescription = summary or subtitle or site.description %}
  {%- set shareTitle = title or site.title %}

  <meta name="author" content="{{ site.author }}">
  <link rel="icon" type="image/x-icon" href="{{ '/favicon.ico' | url }}">
  <meta name="description" content="{{ metaDescription }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }} - {{ site.description }}" href="{{ '/feed.xml' | fullUrl }}">

  <meta name="theme-color" content="#fbf8f3" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#1a1613" media="(prefers-color-scheme: dark)">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Open+Sans:wght@400;600;700;800&display=swap">
  <link rel="stylesheet" href="{{ '/css/site.css' | url }}">

  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ shareTitle }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="{{ page.url | fullUrl }}">
  <link rel="canonical" href="{{ page.url | fullUrl }}">
  {%- if photo %}
  <meta property="og:image" content="{{ photo.src | fullUrl }}">
  <meta property="og:image:alt" content="{{ photo.alt or shareTitle }}">
  {%- endif %}

  <meta name="twitter:card" content="{{ 'summary_large_image' if photo else 'summary' }}">
  <meta name="twitter:title" content="{{ shareTitle }}">
  <meta name="twitter:description" content="{{ metaDescription }}">
  {%- if photo %}
  <meta name="twitter:image" content="{{ photo.src | fullUrl }}">
  <meta name="twitter:image:alt" content="{{ photo.alt or shareTitle }}">
  {%- endif %}
  {%- if jsonLd %}
  <script type="application/ld+json">{{ jsonLd | jsonScript | safe }}</script>
  {%- endif %}
</head>
