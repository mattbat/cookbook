{%- if useSiteTitle -%}
  {%- set pageTitle = site.title + " - " + site.description -%}
{%- else -%}
  {%- set pageTitle = title or site.title -%}
{%- endif -%}
{%- set description = subtitle or (content | plainText | words(50)) -%}
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover">

  <title>{{ pageTitle }}</title>

  <meta name="author" content="{{ site.author }}">
  <link rel="icon" type="image/x-icon" href="{{ '/favicon.ico' | url }}">
  {% if subtitle %}<meta name="description" content="{{ subtitle }}">{% endif %}
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }} - {{ site.description }}" href="{{ '/feed.xml' | fullUrl }}">

  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.6.0/css/font-awesome.min.css">
  <link rel="stylesheet" href="{{ '/css/bootstrap.min.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/main.css' | url }}">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Lora:400,700,400italic,700italic">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Open+Sans:300italic,400italic,600italic,700italic,800italic,400,300,600,700,800">

  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ page.url | fullUrl }}">
  <link rel="canonical" href="{{ page.url | fullUrl }}">
  <meta property="og:image" content="{{ site.avatar | fullUrl }}">

  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ title or site.title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ site.avatar | fullUrl }}">
</head>
