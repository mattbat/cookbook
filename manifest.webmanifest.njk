---
permalink: /manifest.webmanifest
eleventyExcludeFromCollections: true
---
{
  "id": "{{ '/' | url }}",
  "name": "{{ site.name }}",
  "short_name": "Recipes",
  "description": "{{ site.description }}",
  "lang": "en",
  "start_url": "{{ '/' | url }}",
  "scope": "{{ '/' | url }}",
  "display": "standalone",
  "background_color": "#fbf8f3",
  "theme_color": "#fbf8f3",
  "icons": [
    { "src": "{{ '/icons/icon-192.png' | url }}", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "{{ '/icons/icon-512.png' | url }}", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "{{ '/icons/maskable-512.png' | url }}", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Search", "url": "{{ '/search/' | url }}", "icons": [{ "src": "{{ '/icons/icon-192.png' | url }}", "sizes": "192x192" }] },
    { "name": "All recipes A–Z", "short_name": "A–Z", "url": "{{ '/list/' | url }}", "icons": [{ "src": "{{ '/icons/icon-192.png' | url }}", "sizes": "192x192" }] }
  ]
}
