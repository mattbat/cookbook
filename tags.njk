---
layout: base.njk
title: Browse
permalink: /tags/
---
{%- set allTags = collections.recipes | allTags %}
<h1>Browse</h1>
<nav class="chips" aria-label="Jump to a tag">
  {%- for tag in allTags %}
  <a class="chip tag-{{ tag | tagId }}" href="#{{ tag | tagId }}">{{ tag }}</a>
  {%- endfor %}
</nav>

{%- for tag in allTags %}
<section class="shelf">
  <h2 id="{{ tag | tagId }}">{{ tag }}</h2>
  <div class="cards">
    {%- for recipe in collections.recipes | withTag(tag) | byTitle %}{% include "recipe-card.njk" %}{% endfor %}
  </div>
</section>
{%- endfor %}
