---
layout: base.njk
title: Batchelder Recipes
subtitle: A cookbook of our favorite family recipes
useSiteTitle: true
---
<section class="hero">
  <h1>{{ title }}</h1>
  <p class="lede">{{ subtitle }}</p>
  <form class="searchbox" action="{{ '/search/' | url }}" role="search">
    {% icon "search" %}
    <input type="search" name="q" placeholder="Search recipes or ingredients" aria-label="Search recipes" autocomplete="off" enterkeyhint="search">
  </form>
  {% include "category-chips.njk" %}
</section>

{#- Shown by app.js on phones that can add the cookbook to the home screen #}
<aside class="install" aria-label="Add to home screen" hidden>
  <img src="{{ '/icons/icon-192.png' | url }}" width="48" height="48" alt="">
  <div class="install-text">
    <p class="install-title">Put the cookbook on your home screen</p>
    <p class="install-how">It opens like an app and works without signal.</p>
    <p class="install-ios" hidden>Tap {% icon "share" %} <b>Share</b>, then <b>Add to Home Screen</b>.</p>
  </div>
  <button type="button" class="tool tool-primary install-button" hidden>Install</button>
  <button type="button" class="install-close" aria-label="Not now">&times;</button>
</aside>

{%- set featured = collections.recipes | withTag("featured") | newestFirst %}
{%- if featured.length %}
<section class="shelf">
  <h2>Featured</h2>
  <div class="cards">
    {%- for recipe in featured %}{% include "recipe-card.njk" %}{% endfor %}
  </div>
</section>
{%- endif %}

<section class="shelf">
  <h2>Recently added</h2>
  <div class="cards">
    {%- for recipe in collections.recipes | newestFirst | limit(8) %}{% include "recipe-card.njk" %}{% endfor %}
  </div>
  <p class="more"><a href="{{ '/list/' | url }}">All {{ collections.recipes.length }} recipes A–Z &rarr;</a></p>
</section>
