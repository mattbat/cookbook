---
permalink: /list.json
eleventyExcludeFromCollections: true
---
{#- Search index: one entry per recipe, read by js/search.js #}
[
  {%- for recipe in collections.recipes %}
  {
    "title": {{ recipe.data.title | dump | safe }},
    "author": {{ (recipe.data.author or "") | dump | safe }},
    "url": {{ recipe.url | url | dump | safe }},
    "tags": {{ (recipe.data.tags or []) | join(", ") | dump | safe }},
    "date": {{ recipe.date | isoDate | dump | safe }},
    "sourceUrl": {{ (recipe.data.sourceUrl or "") | dump | safe }},
    "ingredients": {{ (recipe.content | recipeSections).ingredients | plainText | dump | safe }},
    "text": {{ (recipe.content | recipeSections).method | plainText | dump | safe }}
  }{% if not loop.last %},{% endif %}
  {%- endfor %}
]
