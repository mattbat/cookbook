---
layout: base.njk
title: All Recipes
useSiteTitle: true
permalink: /list/
---
<h1>All recipes <span class="count">{{ collections.recipes.length }}</span></h1>
<ul class="index">
  {%- for recipe in collections.recipes | byTitle %}
  <li>
    <a href="{{ recipe.url | url }}">
      {%- if recipe.data.photo %}<img src="{{ recipe.data.photo.src | url }}" alt="" sizes="72px">{% endif %}
      <span class="index-title">{{ recipe.data.title }}</span>
      <span class="index-tags">{{ recipe.data.tags | join(", ") }}</span>
    </a>
  </li>
  {%- endfor %}
</ul>
