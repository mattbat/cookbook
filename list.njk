---
layout: page.njk
title: All Recipes
useSiteTitle: true
permalink: /list/
---
<div class="posts-list">
  {%- for recipe in collections.recipes | byTitle %}
  <article class="post-preview post-list-preview">
    <a href="{{ recipe.url | url }}">
      <h2 class="post-title">{{ recipe.data.title }}</h2>
      {% if recipe.data.subtitle %}<h3 class="post-subtitle">{{ recipe.data.subtitle }}</h3>{% endif %}
    </a>

    {%- if recipe.data.tags and recipe.data.tags.length %}
    <div class="blog-tags">
      {%- for tag in recipe.data.tags %}
      <a class="tag-{{ tag | tagId }}" href="{{ '/tags/' | url }}#{{ tag | tagId }}">{{ tag }}</a>
      {%- endfor %}
    </div>
    {%- endif %}
  </article>
  {%- endfor %}
</div>
