---
layout: base.njk
---
<header class="header-section">
  <div class="intro-header no-img">
    <div class="container">
      <div class="row">
        <div class="col-lg-8 col-lg-offset-2 col-md-10 col-md-offset-1">
          <div class="page-heading">
            <h1>{{ title }}</h1>
            {% if subtitle %}
            <hr class="small">
            <span class="page-subheading">{{ subtitle }}</span>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<div class="container" role="main">
  <div class="row">
    <div class="col-xs-12">
      {{ content | safe }}
    </div>
  </div>
</div>
