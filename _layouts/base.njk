<!DOCTYPE html>
<html lang="en">
  {% include "head.njk" %}

  <body data-base="{{ '/' | url }}">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="topbar">
      <div class="topbar-inner">
        {#- Installed on a phone there's no browser Back button, so the app has its own #}
        {%- if page.url != '/' %}
        <a class="back" href="{{ '/' | url }}" aria-label="Back">{% icon "back" %}</a>
        {%- endif %}
        <a class="brand" href="{{ '/' | url }}">{{ site.name }}</a>
        <nav class="topnav" aria-label="Main">
          {%- for tab in site.tabs %}
          <a href="{{ tab.url | url }}"{% if page.url | isCurrent(tab.url) %} aria-current="page"{% endif %}>{{ tab.title }}</a>
          {%- endfor %}
        </nav>
      </div>
    </header>

    <main id="main" class="{{ mainClass or 'page' }}">
      {{ content | safe }}
    </main>

    <footer class="footer">
      <p>
        {{ site.author }} &middot; {{ build.year }} &middot;
        <a href="{{ '/feed.xml' | url }}">RSS</a> &middot;
        <a href="https://github.com/{{ site.github }}/cookbook">GitHub</a>
      </p>
    </footer>

    {#- App-style tabs along the bottom on phones (hidden on wide screens, which use the top bar) #}
    <nav class="tabbar" aria-label="Main">
      {%- for tab in site.tabs %}
      <a href="{{ tab.url | url }}"{% if page.url | isCurrent(tab.url) %} aria-current="page"{% endif %}>
        {% icon tab.icon %}<span>{{ tab.title }}</span>
      </a>
      {%- endfor %}
    </nav>

    <script src="{{ '/js/app.js' | url }}"></script>
    <script src="{{ '/js/timers.js' | url }}"></script>
    {%- for script in scripts %}
    <script src="{{ script | url }}"></script>
    {%- endfor %}
  </body>
</html>
